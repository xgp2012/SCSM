# ── SC-Panel 环境变量示例 ─────────────────────────────────────────────
# 复制为 .env 并按需修改。

# 面板监听
PANEL_HOST=127.0.0.1
PANEL_PORT=3001

# 单管理员账号（首启若无 PANEL_PASSWORD_HASH，将用 PANEL_PASSWORD 生成哈希或随机密码打印一次）
PANEL_USER=admin
PANEL_PASSWORD=change-me

# JWT
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=12h

# 跨域 / 前端地址（开发期 Nuxt 代理）
PANEL_CORS_ORIGIN=http://localhost:3000

# 数据目录（面板自身数据：实例元数据、日志）
PANEL_DATA_DIR=./data

# 缺省实例模板（服务端本体目录），相对后端进程工作目录（apps/api）
SERVER_TEMPLATE_DIR=../../../SurvivalcraftNet/服务端本体

# 优雅停止等待（毫秒），超时后 SIGTERM → SIGKILL
STOP_GRACE_MS=15000

# 日志
LOG_LEVEL=info
LOG_PRETTY=true

# 版本下载（Gitee）
GITEE_REPO=SC-SPM/SurvivalcraftNet
GITEE_MIRROR=
# 版本来源 id（默认 gitee；预留第三方源）与 releases 列表缓存时长（ms，0=不缓存）
VERSION_SOURCE=gitee
VERSION_CACHE_MS=300000
# 单个版本包下载大小上限（字节），默认 2GB
VERSION_MAX_BYTES=2147483648

# 探测/指标周期（毫秒），0 表示禁用
PROBE_INTERVAL_MS=5000
METRICS_INTERVAL_MS=3000

# 存档与备份（M5）
# 定时自动备份间隔（毫秒），0 表示禁用；门禁可用短周期（如 20000）验证
BACKUP_INTERVAL_MS=0
# 每个实例保留的最大备份数量，超出按时间淘汰旧备份，0 不限制
BACKUP_KEEP=10
